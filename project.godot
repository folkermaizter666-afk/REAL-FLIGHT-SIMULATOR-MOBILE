config_version=5

[application]
config/name="REAL FLIGHT SIMULATOR MOBILE"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Prototipo móvil de simulación de vuelo comercial inspirado en el Boeing 737-800."

[display]
window/size/viewport_width=960
window/size/viewport_height=432
window/size/window_width_override=960
window/size/window_height_override=432
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.42, 0.68, 0.9, 1)
